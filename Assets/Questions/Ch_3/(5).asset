  m_Script: {fileID: 11500000, guid: 9ceb229ddb3e9184f974dbd7750c0201, type: 3}
  m_Name: (5)
  m_EditorClassIdentifier: 
  question: "\xBFPor qu\xE9 crees que los reyes han elegido este sitio como lugar
    del casamiento?"
  answers:
  - answerText: Por haber sido elegida tradicionalmente para los matrimonios entre
      ambas coronas
    isCorrect: 0
  - answerText: Por encontrarse a medio camino entre Toledo y Lisboa
    isCorrect: 0
  - answerText: Por su proximidad con la frontera castellano-portuguesa
    isCorrect: 1
  - answerText: "Porque pertenec\xEDa a la Corona Portuguesa y facilitaba la llegada
      de Manuel I"
    isCorrect: 0
