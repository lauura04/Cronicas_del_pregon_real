  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Bonita moneda. \xBFDe d\xF3nde ha salido?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 712b62691c097a945bba00f2356ef188, type: 2}
    text: Me la dieron para jugar.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Entonces no fuiste t\xFA quien encontr\xF3 la bolsa."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 712b62691c097a945bba00f2356ef188, type: 2}
    text: "\xBFQu\xE9 bolsa?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
