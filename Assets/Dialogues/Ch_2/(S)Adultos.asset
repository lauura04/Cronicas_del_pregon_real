  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (S)Adultos
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Nunca hubiera esperado eso de \xE9l, siempre fue un buen hombre."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: "Yo tampoco, estuvo trabajando para m\xED y nunca tuve un problema con
      \xE9l, y mira que antes estaba en peores condiciones."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 62b418f5bb4446447a22dabd0a9b08f1, type: 2}
    text: "Pues yo no creo que haya sido \xE9l, creo que ha sido una cosa de ni\xF1os
      y \xE9l estaba en el lugar equivocado en el momento equivocado."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
