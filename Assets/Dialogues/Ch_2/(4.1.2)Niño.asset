  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "\xBFTambi\xE9n t\xFA tienes parte del tesoro?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "\xA1Solo esta piedra! Me la regalaron."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "\xBFQui\xE9n?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "Promet\xED que no lo dir\xEDa..."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
