MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (4.1)Grupo
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Vaya, \xBFqu\xE9 ten\xE9is ah\xED?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 712b62691c097a945bba00f2356ef188, type: 2}
    text: "\xA1Nuestros tesoros!"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "\xBFTesoros? Esas monedas y piedras no parecen precisamente juguetes."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "\xA1Pero brillan!"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: Y casualmente ha desaparecido una bolsa llena de cosas que brillan...
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 712b62691c097a945bba00f2356ef188, type: 2}
    text: Nosotros no hemos robado nada.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Eso espero. A ver, contadme de d\xF3nde hab\xE9is sacado todo esto."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
