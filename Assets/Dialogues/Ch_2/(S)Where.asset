  lines:
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "\xBFTe has enterado? Un amigo m\xEDo de la iglesia est\xE1 repartiendo
      piedras brillantes, parece que tienen mucho valor."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: f025d440a6e2e6044b2abeae83c4bc37, type: 2}
    text: "\xBFPero eso d\xF3nde?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d8de498397ea0ab4f98da7d95c3797e8, type: 2}
    text: "All\xED, al lado de la fuente. Pero date prisa, porque puede irse en cualquier
      momento"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
