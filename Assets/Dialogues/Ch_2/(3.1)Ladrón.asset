  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: "(3.1)Ladr\xF3n"
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: cb54ec54409ecca4fbb4c6ce6a83b11e, type: 2}
    text: "Se\xF1or, de la bolsa no fui yo, la pondr\xEDan en alg\xFAn lugar y me
      acusan a m\xED, pero juro por mi vida que no he sido yo quien lo hizo."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: cb54ec54409ecca4fbb4c6ce6a83b11e, type: 2}
    text: "Pregunte al pueblo, escuche a los ni\xF1os, nunca rob\xE9 nada, siempre
      fui un siervo honrado."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
