  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Tintes, betunes, pigmentos... El oficio de zapatero deja manchas dif\xEDciles
      de esconder. "
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Tinte de zapatero... Y todav\xEDa mancha. Interesante. Lo coger\xE9."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
