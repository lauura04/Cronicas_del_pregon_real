  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (S)Who
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "Pero, y ese amigo tuyo, \xBFqui\xE9n es? \xBFLo conozco?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: f025d440a6e2e6044b2abeae83c4bc37, type: 2}
    text: "Es hijo de un se\xF1or con mucho dinero, pero no lo aparenta, va vestido
      como el resto."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 712b62691c097a945bba00f2356ef188, type: 2}
    text: "S\xED bueno, yo nunca hab\xEDa visto un pelo tan rubio hasta conocerle."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 785237e172ab0af4dbdab7f48e7e25a4, type: 2}
    text: Uy y sus ojos son del color del cielo.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: f025d440a6e2e6044b2abeae83c4bc37, type: 2}
    text: "Ya, ya. No s\xE9 por qu\xE9 le gusta la ropa verde, se creer\xE1 cesped
      o algo."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: cfccb681168a41246a94ebf928aeae7f, type: 2}
    text: "Pero no te metas con \xE9l, es un color muy bonito."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
