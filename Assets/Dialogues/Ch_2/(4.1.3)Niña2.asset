  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "D\xE9jame adivinar. A ti tambi\xE9n te lo dieron."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 785237e172ab0af4dbdab7f48e7e25a4, type: 2}
    text: "S\xED. \xA1Pero yo eleg\xED la m\xE1s bonita!"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "\xBFHab\xEDa m\xE1s?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 785237e172ab0af4dbdab7f48e7e25a4, type: 2}
    text: "Un mont\xF3n, dentro de una bolsa."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
