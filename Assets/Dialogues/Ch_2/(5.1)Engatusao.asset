--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (5.1)Engatusao
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "\xBFY ahora? \xBFSabes algo?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 93d19da177ed82049b1637d89283a6ee, type: 2}
    text: "Lo admito, fui yo, cog\xED esa bolsa, pero porque pens\xE9 que era unnuevo
      juguete para m\xED."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Pues esta peque\xF1a travesura ha puesto en peligro la vida de vuestro
      criado."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 93d19da177ed82049b1637d89283a6ee, type: 2}
    text: "\xBFQu\xE9 tengo que hacer para salvarle?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 79fa6db377b64ee48a8c949ed1c539f8, type: 2}
    text: "Dame lo que queda de esa bolsa y me encargar\xE9 de que lo liberen."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 93d19da177ed82049b1637d89283a6ee, type: 2}
    text: Toma.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
