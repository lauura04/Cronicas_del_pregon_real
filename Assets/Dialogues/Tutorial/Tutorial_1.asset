%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Tutorial_1
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "\xA1Vamos mi peque\xF1o aprendiz! \xA1Utiliza W, A, S, D para vernir hacia
      m\xED!"
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "\xA1Pero ap\xFArate usando Shift, que vamos a llegar tarde al enlace real!"
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Bien muchacho, ahora tenemos que hacernos paso entre los monjes para poder
      llegar al casamiento, pero mant\xE9n tus o\xEDdos abiertos, que toda informaci\xF3n
      es \xFAtil y nunca est\xE1 de m\xE1s almacenarla."
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: Si te olvidas de lo que escuchaste siempre puedes ir a tus notas pulsando
      TAB.
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Buenas tardes tengan vuesas mercedes. \xBFSer\xEDan tan amables de dejarnos
      pasar tanto a m\xED como a mi joven pupilo al lugar de la celebraci\xF3n?"
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Hemos sido invitados para amenizar el enlace de sus j\xF3venes majestades."
  - character: {fileID: 11400000, guid: a011722f1e9e034418c0a61806b0c672, type: 2}
    text: "Tenemos la orden de no dejar pasar a nadie, mas algo de amenizaci\xF3n
      siempre viene bien."
  - character: {fileID: 11400000, guid: a011722f1e9e034418c0a61806b0c672, type: 2}
    text: "Toca para nosotros y ya de aqu\xED no os mov\xE9is."
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Dicen que la m\xFAsica amaina a las fieras, pues es la hora de demostrarlo. "
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "\xBFQuieren m\xFAsica? Pues gracias a ella nos dejar\xE1n pasar"
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Mira Benjam\xEDn, all\xED al principio de la estancia se encuentra nuestra
      princesa la Infanta, tan bella como su madre pero m\xE1s jovial."
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Ac\xE9rcate jovem para presentar tus respetos a la joven pareja, mas no
      se te olvide lo aprendido."
