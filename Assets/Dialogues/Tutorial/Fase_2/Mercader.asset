  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Mercader
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: dfbaa2dc0eba40a40825b794f43cdcbd, type: 2}
    text: "As\xED que de joyas va la cosa. Poseo todo tipo de piedras preciosas de
      India, as\xED como de perlas que yo mismo rescat\xE9 del m\xE1s profundo mar. "
  - character: {fileID: 11400000, guid: dfbaa2dc0eba40a40825b794f43cdcbd, type: 2}
    text: "Mas est\xE9 seguro de aquello que desea comprar pues luego la Infanta
      cargar\xE1 su ira contra vos."
