MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Herrero
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 50aed25c8fb2f8a418a5af5c1ce990ff, type: 2}
    text: "Armas tal vez no sirvan en esta ocasi\xF3n, pero un enganche para dicha
      alhaja s\xED puedo proporcionarle."
  - character: {fileID: 11400000, guid: 50aed25c8fb2f8a418a5af5c1ce990ff, type: 2}
    text: "Si vuesa merced me hace el favor de descubrir el misterio del l\xEDquido
      granate que esconden los monjes "
  - character: {fileID: 11400000, guid: 50aed25c8fb2f8a418a5af5c1ce990ff, type: 2}
    text: "de este convento con tanto recelo le dar\xE9 aquello que le ser\xE1 de
      ayuda."
  - character: {fileID: 11400000, guid: 50aed25c8fb2f8a418a5af5c1ce990ff, type: 2}
    text: "Mas los monjes se negar\xE1n a hablar, tendr\xE1s que pensar en algo para
      escucharlos sin que te detecten."
