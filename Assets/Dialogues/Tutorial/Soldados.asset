--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Soldados
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Buenas tardes tengan vuesas mercedes. \xBFSer\xEDan tan amables de dejarnos
      pasar tanto a m\xED como a mi joven pupilo al lugar de la celebraci\xF3n?"
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Hemos sido invitados para amenizar el enlace de sus j\xF3venes majestades."
  - character: {fileID: 11400000, guid: a011722f1e9e034418c0a61806b0c672, type: 2}
    text: "Tenemos la orden de no dejar pasar a nadie, mas algo de diversi\xF3n siempre
      viene bien. Tocad para nosotros y aqu\xED permanecer\xE9is."
  - character: {fileID: 11400000, guid: 3f9d660e59351d6468258772802a4d23, type: 2}
    text: "Dicen que la m\xFAsica amansa a las fieras, pues es la hora de demostrarlo.
      \xBFQuieren m\xFAsica? Pues gracias a ella nos dejar\xE1n pasar."
