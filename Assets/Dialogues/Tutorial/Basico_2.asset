  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Basico_2
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Nunca hab\xEDa vendido tantas cintas en un solo d\xEDa."
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: Ni yo tantas telas. Todo el mundo quiere vestir sus mejores galas
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Si esto dura una semana m\xE1s voy a volver a casa con la bolsa llena."
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: Aprovecha mientras puedas que cuando se vayan volveremos a la normalidad.
