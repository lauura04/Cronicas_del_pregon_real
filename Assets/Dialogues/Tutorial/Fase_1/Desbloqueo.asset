MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Desbloqueo
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Pues yo he o\xEDdo decir que a la princesa le gustan mucho los animales."
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: No creo que un animal sea un regalo propicio por su casamiento, a fin de
      cuentas, puede conseguir el animal que quiera en cualquier otro momento.
  - character: {fileID: 11400000, guid: 62b418f5bb4446447a22dabd0a9b08f1, type: 2}
    text: "Ni animales, ni manjares ni otro tipo de v\xEDveres, las joyas es lo que
      m\xE1s congratula a su majestad, "
  - character: {fileID: 11400000, guid: 62b418f5bb4446447a22dabd0a9b08f1, type: 2}
    text: "si agradarla quer\xE9is m\xE1s os vale buscar una joya sin igual"
