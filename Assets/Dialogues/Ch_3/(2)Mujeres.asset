MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (2)Mujeres
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: ca443bc81ed58e74da099d16a583665c, type: 2}
    text: "\xA1Corred! \xA1Corred que se viene la noche encima y ya est\xE1 la pompa
      preparada!"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 658c142d5757a8f40958717eecf9ed2c, type: 2}
    text: "\xA1Ahora viene esta con fuerte premura! Mira que lo dije hace tiempo
      ya. \xA1Que se nos hac\xEDa tarde y no lleg\xE1bamos a la boda!"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 83281260bf21207469fd6ed90e747471, type: 2}
    text: "\xA1Y lo peor de todo no es eso! Lo peor es que tenemos ya a todo el pueblo
      bajando la calle y nos ver\xE1 de esta guisa."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
