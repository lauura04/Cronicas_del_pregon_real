%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Baluarte
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: Te aseguro que era ella.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: "\xBFLa reina? \xBFAqu\xED?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "La vi pasar hace apenas un momento, acompa\xF1ada por sus guardias."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: "\xBFEntr\xF3 en alguna de las casas?"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "No. Rodearon la \xFAltima y continuaron hacia el baluarte."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: "Curioso lugar para una reina en el d\xEDa de la boda de su hija."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Quiz\xE1 precisamente por eso lo ha elegido. Desde all\xED puede apartarse
      un momento del gent\xEDo para rezar por su hijo Juan."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
