  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (7)Reina
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: 42be8fcd3850d9346872e802c8da55fa, type: 2}
    text: "\xA1Buf\xF3n! \xBFQu\xE9 algarab\xEDa es esta? Dejad lo que sea que est\xE9s
      haciendo porque te encargo una misi\xF3n."
  - character: {fileID: 11400000, guid: 42be8fcd3850d9346872e802c8da55fa, type: 2}
    text: "Toma esta lista y aseg\xFArate de tener todo preparado para la fecha del
      enlace. Adem\xE1s, ser\xE9is el encargado de anunciar"
  - character: {fileID: 11400000, guid: 42be8fcd3850d9346872e802c8da55fa, type: 2}
    text: "por las villas la celebraci\xF3n del casamiento. Lo dejo en tus manos."
