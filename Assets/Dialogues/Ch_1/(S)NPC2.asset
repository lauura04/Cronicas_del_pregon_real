  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: (S)NPC2
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Dicen que ma\xF1ana volver\xE1n a montar puestos junto a la iglesia."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: bbc6f7ec1a982b446ba526934c0ff2e7, type: 2}
    text: "M\xE1s les vale dejar sitio para pasar. La \xFAltima vez no cab\xEDa ni
      un carro por la plaza."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: 62b418f5bb4446447a22dabd0a9b08f1, type: 2}
    text: "T\xFA te quejas, pero bien que fuiste el primero en comprar vino"
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: b514cc97c69ba9642b655e5a906af0b8, type: 2}
    text: "Pues yo he o\xEDdo que vienen otros mercaderes de bastante lejos. Traer\xE1n
      telas, especias y qui\xE9n sabe qu\xE9 m\xE1s."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
