MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Tutorial
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Debiera antes de empezar, pues la ocasi\xF3n lo merece, al buen lector
      contar lo que en su mano sostiene."
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "De una obra se trata, servidor el escritor, Gin\xE9s es mi nombre y le
      acompa\xF1ar\xE9 en la ficci\xF3n."
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Mas de ficci\xF3n no se habla, pues los hechos sucedieron, all\xE1 por
      1497 pero no nos adelantemos."
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "La infanta Isabel es sobre quien va esta historia, pero ser\xE1 un fiel
      buf\xF3n el que cuente las sus memorias."
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Acompa\xF1adle fiel lector en esta intr\xE9pida aventura, donde hay puzles,
      exploraci\xF3n, misterio y de ello no cabe duda."
