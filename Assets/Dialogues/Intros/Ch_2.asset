%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2890b10a6202c684983e32e79f25b064, type: 3}
  m_Name: Ch_2
  m_EditorClassIdentifier: 
  lines:
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Pero no se equivoquen, que hab\xEDa otro pueblo que habitaba desde antiguo
      y a su libre albedr\xEDo."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: Guadalupe es el nombre de esta tierra lejana, entre montes escondida y
      por peregrinos frecuentada.
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Ya est\xE1n todos oyendo que el destino caprichoso a veces aprieta, pero
      no ahoga... aunque no a todos traten de igual modo."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Pues por villas y caminos una sombra se levantaba, y bajo el nombre de
      la fe la Inquisici\xF3n vigilaba."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: "Preguntaba por costumbres, por palabras y miradas, y hasta el silencio
      m\xE1s peque\xF1o pod\xEDa despertar sospechas calladas."
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
  - character: {fileID: 11400000, guid: d7f87c407013d8f4dacfa29e3aefd9b5, type: 2}
    text: 'Mas nuestra historia prosigue, que otra empresa nos aguarda: en Guadalupe
      se preparan los pasos de una boda anunciada.'
    leftImage: {fileID: 0}
    rightImage: {fileID: 0}
